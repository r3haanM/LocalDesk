# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ============================================================================
# WINDOWS DESKTOP BUILD & AUTHENTICODE SIGNING CONFIGURATION
# ============================================================================
# Development Environment Defaults (Unsigned Local Development & Testing):
# - WIN_CSC_LINK and WIN_CSC_KEY_PASSWORD are natively recognized by Electron Builder
#   and also consumed by scripts/authenticode_signer.ts. Leave unset for dev builds.
# - WIN_PUBLISHER_NAME, WIN_TIMESTAMP_SERVER, FORCE_CODE_SIGNING, and
#   ALLOW_UNSIGNED_DEV_BUILDS are consumed by scripts/authenticode_signer.ts
#   and scripts/build_windows_release.ts.
WIN_CSC_LINK=
WIN_CSC_KEY_PASSWORD=
WIN_PUBLISHER_NAME=
WIN_TIMESTAMP_SERVER=
FORCE_CODE_SIGNING=false
ALLOW_UNSIGNED_DEV_BUILDS=true

# Optional GitHub Repository URL displayed in the top navigation bar and Rehan Mumtaz signature overlay:
VITE_GITHUB_REPO_URL="https://github.com/rehanmumtaz/local-desk"

