{
  "name": "local-desk",
  "productName": "Local Desk",
  "description": "Local Desk — All-in-One PDF & Document Studio",
  "author": {
    "name": "Local Desk Studio",
    "email": "security@localdesk.app"
  },
  "license": "MIT",
  "private": true,
  "version": "1.0.4",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "start": "tsx server.ts",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test:qa": "tsx scripts/qa_validation_suite.ts",
    "desktop:release": "FORCE_CODE_SIGNING=false ALLOW_UNSIGNED_DEV_BUILDS=true tsx scripts/build_windows_release.ts",
    "desktop:release:dev": "FORCE_CODE_SIGNING=false ALLOW_UNSIGNED_DEV_BUILDS=true tsx scripts/build_windows_release.ts",
    "desktop:release:prod": "FORCE_CODE_SIGNING=true ALLOW_UNSIGNED_DEV_BUILDS=false tsx scripts/build_windows_release.ts",
    "desktop:electron": "electron electron/main.cjs",
    "desktop:dist:win": "FORCE_CODE_SIGNING=false ALLOW_UNSIGNED_DEV_BUILDS=true vite build && electron-builder --win --x64 --config electron-builder.yml",
    "desktop:dist:win:dev": "FORCE_CODE_SIGNING=false ALLOW_UNSIGNED_DEV_BUILDS=true vite build && electron-builder --win --x64 --config electron-builder.yml",
    "desktop:dist:win:prod": "FORCE_CODE_SIGNING=true ALLOW_UNSIGNED_DEV_BUILDS=false vite build && electron-builder --win --x64 --config electron-builder.prod.yml -c.win.forceCodeSigning=true"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.1.1",
    "docx": "^9.15.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "gsap": "^3.15.0",
    "jszip": "^3.10.2",
    "lucide-react": "^0.546.0",
    "mammoth": "^1.13.0",
    "motion": "^12.23.24",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.4.299",
    "pptxgenjs": "^4.0.1",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "tesseract.js": "^7.0.0",
    "three": "^0.187.0",
    "vite": "^8.3.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "@types/express": "^4.17.21"
  }
}
