<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.LocalDesk.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_brand_app</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/splash_icon_bg</item>
        <item name="windowSplashScreenAnimationDuration">400</item>
        <item name="postSplashScreenTheme">@style/Theme.LocalDesk.Main</item>
    </style>

    <style name="Theme.LocalDesk.Main" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
